  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "build": "expo export --platform all",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/db-seed.mjs",
    "neon:env": "node scripts/neon-public-env.mjs",
    "backend:dev": "neon dev",
    "backend:deploy": "neon deploy --env .env.local --no-env-pull",
    "backend:env": "neon env pull --file .env.local --service functions",
    "build:web": "expo export --platform web",
    "images:optimize": "python3 scripts/optimize-images.py",
    "measure:web": "node scripts/measure-web-export.mjs dist"
  },
  "private": true
