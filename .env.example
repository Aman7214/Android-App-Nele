# Server-only Neon variables. Obtain values with neon env pull.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_FUNCTION_API_BASE_URL=

# Public service URLs used by the Expo app; these contain no credentials.
EXPO_PUBLIC_NEON_API_URL=
EXPO_PUBLIC_NEON_AUTH_URL=

# Optional HTTPS base URL for public/images/nele WebP assets. Bundled images work without it.
EXPO_PUBLIC_IMAGE_CDN_URL=

# Comma-separated web origins accepted by the API; native requests have no Origin header.
APP_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
